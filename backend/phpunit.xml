<?xml version="1.0" encoding="UTF-8"?>

<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>

        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>

    </testsuites>

    <php>

        <!--
        ================================================================
        APPLICATION
        ================================================================
        -->

        <env
            name="APP_ENV"
            value="testing"
        />

        <env
            name="APP_KEY"
            value="base64:vdg6Koh34YaUyP9tPG2C7OoKuFC3jvT+ZekNcMXL9DY="
        />

        <env
            name="APP_DEBUG"
            value="true"
        />

        <env
            name="APP_MAINTENANCE_DRIVER"
            value="file"
        />

        <env
            name="BCRYPT_ROUNDS"
            value="4"
        />


        <!--
        ================================================================
        DATABASE
        ================================================================

        Feature tests use an in-memory SQLite database.

        This keeps tests isolated from the normal PostgreSQL database.
        -->

        <env
            name="DB_CONNECTION"
            value="sqlite"
        />

        <env
            name="DB_DATABASE"
            value=":memory:"
        />


        <!--
        ================================================================
        SESSION / SANCTUM
        ================================================================
        -->

        <env
            name="SESSION_DRIVER"
            value="array"
        />

        <env
            name="SESSION_ENCRYPT"
            value="false"
        />

        <env
            name="SANCTUM_STATEFUL_DOMAINS"
            value="localhost,localhost:5173,127.0.0.1,127.0.0.1:5173"
        />


        <!--
        ================================================================
        CACHE
        ================================================================
        -->

        <env
            name="CACHE_STORE"
            value="array"
        />


        <!--
        ================================================================
        QUEUES
        ================================================================
        -->

        <env
            name="QUEUE_CONNECTION"
            value="sync"
        />


        <!--
        ================================================================
        MAIL
        ================================================================
        -->

        <env
            name="MAIL_MAILER"
            value="array"
        />


        <!--
        ================================================================
        FILESYSTEM
        ================================================================
        -->

        <env
            name="FILESYSTEM_DISK"
            value="local"
        />


        <!--
        ================================================================
        LOGGING
        ================================================================
        -->

        <env
            name="LOG_CHANNEL"
            value="null"
        />

    </php>

</phpunit>